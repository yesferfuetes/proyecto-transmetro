{
  "name": "transmetro-frontend",
  "version": "0.1.0",
  "description": "Aplicación web del Sistema de Información y Control Operativo de Transmetro",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/preparar-standalone.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "tamano-paquete": "node scripts/tamano-paquete.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "~5.9.1",
    "clsx": "~2.1.1",
    "lucide-react": "~1.52.0",
    "next": "~16.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hook-form": "~7.89.0",
    "server-only": "~0.0.1",
    "tailwind-merge": "~3.7.0",
    "zod": "~4.6.5",
    "zustand": "~5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@playwright/test": "~1.63.0",
    "@tailwindcss/turbopack": "~4.3.3",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.7",
    "@types/node": "~24.19.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "~5.0.3",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-better-tailwindcss": "~4.9.0",
    "eslint-plugin-boundaries": "~7.2.0",
    "globals": "~17.13.0",
    "jsdom": "~30.1.2",
    "prettier": "~3.9.9",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "~8.3.3",
    "vitest": "~5.0.3"
  }
}
