    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "~4.3.3",
    "@types/node": "~24.19.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3"
  }
}
