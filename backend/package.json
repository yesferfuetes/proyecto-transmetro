{
  "name": "transmetro-backend",
  "version": "0.1.0",
  "description": "API del Sistema de Información y Control Operativo de Transmetro",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,mjs,json}\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage",
    "openapi": "node --env-file-if-exists=.env dist/openapi.js",
    "migration:run": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:run -d dist/shared/database/fuente-datos.js",
    "migration:revert": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:revert -d dist/shared/database/fuente-datos.js",
    "migration:check": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:generate src/migrations/Deriva --check --dryrun -d dist/shared/database/fuente-datos.js",
    "test:integracion": "node --experimental-vm-modules --no-warnings=ExperimentalWarning --env-file-if-exists=.env node_modules/jest/bin/jest.js -c jest.integracion.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "~12.1.2",
    "@nestjs/config": "~12.0.1",
    "@nestjs/core": "~12.1.2",
    "@nestjs/cqrs": "~12.1.0",
    "@nestjs/platform-express": "~12.1.2",
    "@nestjs/swagger": "~12.0.2",
    "@nestjs/terminus": "~12.1.0",
    "@nestjs/typeorm": "~12.0.2",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.15.1",
    "pg": "~8.23.1",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "typeorm": "~1.1.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@nestjs/cli": "~12.0.8",
    "@nestjs/schematics": "~12.0.6",
    "@nestjs/testing": "~12.1.2",
    "@types/express": "~5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "~24.19.1",
    "@types/pg": "~8.23.1",
    "eslint": "~10.12.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-boundaries": "~7.2.0",
    "globals": "~17.13.0",
    "jest": "~30.5.2",
    "prettier": "~3.9.9",
    "ts-jest": "~29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1"
  }
}
